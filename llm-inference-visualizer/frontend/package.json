{
  "name": "llm-inference-lab-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:data": "node scripts/sync-benchmarks.mjs",
    "build": "npm run sync:data && tsc -b && vite build",
